add(2,[F('A value proposition communicates the benefit a product delivers to a specific target customer.','pp_value-proposition','What is a Value Proposition?'),F('The message should address the customer’s problem or job and explain the benefit or gain the product creates.','pp_value-proposition','How do You Create a Value Proposition?'),F('Write a proposition by naming the target customer, the problem relieved, and the distinct benefit provided.','pp_value-proposition','How do You Create a Value Proposition?'),F('Check that the value is expressed in terms the customer can understand rather than a list of product features.','pp_value-proposition','How do You Create a Value Proposition?')],mis=O[2][1],conf=['Product vision statement'])
add(3,[F('Competitive analysis examines alternatives customers could choose, including indirect competitors.','pp_competitive-landscape','What is Competitive Landscape?'),F('A structured comparison can include features, pricing, market position, strengths, and weaknesses.','pp_competitive-landscape','What Should Competitive Landscape Analysis Include?'),F('Identify the relevant competitors and compare them using the same dimensions.','pp_competitive-landscape','What Should Competitive Landscape Analysis Include?'),F('Use gaps, weaknesses, and differences in the comparison to identify an opportunity or threat relevant to the product.','pp_competitive-landscape','What are the Benefits of Conducting a Competitive Landscape Analysis?')],conf=['Value proposition'])
DATA[4]=O[3]
add(11,[F('TAM is the total potential annual revenue opportunity if the entire relevant market were served.','pp_total-addressable-market','What is Total Addressable Market?'),F('SAM is the portion of TAM that the current product, distribution, and target-market constraints allow the company to serve.','market_tam-sam-som','Calculating SAM'),F('SOM is the portion of SAM the company can realistically obtain within a stated timeframe.','market_tam-sam-som','Calculating SOM'),F('A bottom-up revenue estimate multiplies potential customer count by annual revenue per customer and sums distinct segments where needed.','market_tam-sam-som','Bottom-Up Calculation Example'),F('Narrow TAM to serviceable segments for SAM, then apply an evidence-backed obtainable share within a stated timeframe to estimate SOM.','market_tam-sam-som','Top-Down Calculation Example'),F('Record assumptions about customer counts, spending, serviceable constraints, achievable share, and timeframe so each estimate can be checked.','market_tam-sam-som','Calculating SOM')],conf=['Market segmentation'])
add(16,O[17][0]+[O[18][0][2]],conf=['Problem statement'])
add(17,[F('A solution specification describes the proposed behavior and boundaries of the product change.','atl_product-specification','What is a product specification?'),F('The specification links the proposal to the user problem, goals, functional behavior, and constraints.','atl_product-specification','Key components of a product specification'),F('Write the proposal by explaining the approach, expected behavior, included scope, exclusions, and key constraints.','atl_product-specification','How to write a product specification'),F('Review it with engineering and design to resolve ambiguity before implementation.','atl_product-specification','Best practices for writing product specifications')],conf=['Problem statement'])
add(18,[F('A problem statement describes the user need or difficulty; a solution statement describes a proposed way of addressing it.','atl_product-brief','Step 2: Clarify the problem and audience'),F('Combining the two too early can hide assumptions and narrow the alternatives the team considers.','nngroup_how-might-we-questions','2. Avoid Suggesting a Solution in Your HMW Question'),F('Rewrite a muddled statement into a problem describing who is affected and why, followed by a separate proposal describing the chosen behavior.','atl_product-brief','Step 2: Clarify the problem and audience'),F('Check that the proposed solution addresses the stated problem without redefining the problem as the absence of that solution.','nngroup_how-might-we-questions','2. Avoid Suggesting a Solution in Your HMW Question')],conf=['Problem statement','Solution specification'])
add(27,[F('Release planning assigns selected roadmap work to upcoming release windows.','pp_release-plan','What is a Release Plan?'),F('A release plan is more tactical and detailed than the roadmap’s directional view.','pp_release-plan','What is a Release Plan?'),F('Group work into release windows by considering goals, priority, scope, capacity, and dependencies.','atl_product-planning','Develop product roadmap'),F('Check that prerequisite work comes early enough to enable dependent items and revise the windows if the schedule is infeasible.','atl_project-management-dependencies','How to manage dependencies in project management')],conf=['Product roadmap'])
add(28,[F('Feature sequencing places already-prioritized features in an executable order.','atl_product-planning','Develop product roadmap'),F('A feature that requires another feature’s output cannot be scheduled as if it were independent.','atl_project-management-dependencies','What are project dependencies?'),F('List prerequisites and dependency relationships, then order the features so prerequisites are available when needed.','atl_project-management-dependencies','How to identify dependencies in a project'),F('Use the existing relative priorities to choose among feasible sequences and explain any dependency-driven change in order.','atl_product-planning','Develop product roadmap')],conf=['Release planning'])
add(29,[F('A delivery forecast connects estimated work with the team’s recent completion rate and available time.','atl_velocity-scrum','How to calculate velocity in Scrum'),F('With consistently estimated work, estimated iterations equal remaining work units divided by historical average units completed per iteration.','atl_velocity-scrum','How to calculate velocity in Scrum'),F('Convert the iteration estimate into a date range using iteration length, current timing, and plausible variation in completion rate.','atl_velocity-scrum','How to calculate velocity in Scrum'),F('State the forecast’s assumptions about scope, team availability, dependencies, and historical variability.','atl_velocity-scrum','Factors that can affect Scrum velocity')],mis=[F('A historical average is a forecast input, not a guarantee of the same future rate.','atl_velocity-scrum','How to calculate velocity in Scrum')],conf=['Capacity planning'])
add(31,[F('An initiative is a body of work intended to advance a specific product or business goal.','atl_product-strategy','Product initiatives'),F('An initiative brief makes the problem, audience, goal, scope, assumptions, and success criteria explicit.','atl_product-brief','What is a product brief?'),F('Start from the strategic theme and describe the outcome the initiative is meant to achieve.','atl_product-brief','Step 3: Define goals and success metrics'),F('Write the included scope, exclusions, and measures that would demonstrate the intended outcome.','atl_product-brief','Step 4: Outline scope, assumptions, and open questions')],conf=['Product roadmap','PRD'])
add(33,[F('An MVP is a limited product version built to learn whether a product idea meets customer needs with less initial investment.','atl_minimum-viable-product','What is a minimum viable product (MVP)?'),F('The scope must retain enough of the core value for the intended users to try it and provide useful feedback.','atl_minimum-viable-product','How to create a minimum viable product'),F('Define the target user and learning goal, then select only the capabilities needed to deliver and test the core value.','atl_minimum-viable-product','How to create a minimum viable product'),F('List excluded enhancements and explain why they are unnecessary for the initial value and learning goal.','atl_minimum-viable-product','How to create a minimum viable product')],mis=[F('An MVP is not simply an arbitrary incomplete product with the maximum number of features removed.','atl_minimum-viable-product','What is a minimum viable product (MVP)?')],conf=['Initiative scope'])
add(35,[F('Impact assessment estimates how much a proposed initiative would contribute to a target outcome.','pp_rice-scoring-model','Impact'),F('Choose a common target metric and impact scale before comparing initiatives.','pp_rice-scoring-model','Impact'),F('Estimate the expected contribution using research or observed product evidence, then explain the assumptions behind it.','pp_rice-scoring-model','Impact'),F('State confidence separately so a promising but speculative effect is not treated as equally reliable as an evidence-backed estimate.','pp_rice-scoring-model','Confidence')],conf=['Value-vs-effort matrix'])
add(39,[F('A tradeoff is a choice in which obtaining one benefit can require accepting a cost or giving up another benefit.','pp_weighted-scoring','How is weighted scoring used?'),F('Compare alternatives against the same goals, benefits, costs, and constraints.','pp_weighted-scoring','How can product managers use weighted scoring?'),F('Write the advantages and disadvantages of each option and make the opportunity cost of choosing one explicit.','pp_weighted-scoring','Next Steps'),F('Recommend the option that best fits the stated priorities and explain the downside being accepted.','pp_weighted-scoring','How do you analyze weighted scoring results?')],conf=['Weighted scoring'])
add(46,[F('Audience adaptation changes emphasis, terminology, and detail to suit the recipient’s needs.','more_communication-plan','How to create a communication plan'),F('Different audiences need different information from the same product update.','atl_product-roadmaps','How to create a product roadmap'),F('Identify what each audience needs to understand or decide, then tailor the message’s content and language accordingly.','more_communication-plan','How to create a communication plan'),F('Keep the underlying facts consistent while varying detail and tone for each audience.','more_communication-plan','How to create a communication plan')],conf=['Cross-functional collaboration'])
add(47,[F('A status report summarizes current progress, obstacles, risks, and next steps for a defined audience.','atl_status-report','What is a status report?'),F('Compare actual progress with the intended plan and identify significant deviations.','atl_status-report','What should be included in a status report?'),F('Write the update with completed progress, current status, important risks or blockers, and next actions with owners.','atl_status-report','How to write a status report'),F('Make any needed decision or help request explicit and keep the update concise enough for its audience.','atl_status-report','Best practices for effective status reports')],conf=['Audience adaptation'])
add(48,[F('Executive communication emphasizes the information leadership needs for direction or a decision.','atl_product-roadmaps','How to create a product roadmap'),F('Summarize detailed work in terms of business outcomes, progress, and consequential risks.','atl_status-report','What should be included in a status report?'),F('Lead with the headline, state the decision or support needed, and name the key risk or implication.','atl_status-report','How to write a status report'),F('Keep technical detail subordinate to the executive’s immediate information need.','atl_product-roadmaps','How to create a product roadmap')],conf=['Status reporting'])
add(49,[F('Product messaging communicates the product’s value to its intended audience.','pp_value-proposition','What is a Value Proposition?'),F('A clear headline should foreground the customer benefit rather than an unexplained feature label.','pp_value-proposition','How do You Create a Value Proposition?'),F('Write a headline and supporting points that connect the customer problem to the benefit and meaningful differentiation.','pp_value-proposition','How do You Create a Value Proposition?'),F('Check that the language and claims match the chosen audience and positioning.','pp_product-positioning','Tips for Effective Product Positioning')],conf=['Value proposition','Strategic positioning'])
add(51,[F('Conflict resolution identifies and addresses the competing needs beneath disagreement.','more_conflict-resolution-tips-product-managers-product-owners','Conflict Resolution Tips for Product People'),F('Listen to each participant’s perspective and separate observable events from blame or interpretation.','more_conflict-resolution-tips-product-managers-product-owners','Conflict Resolution Tips for Product People'),F('Restate the shared goal and underlying needs, then generate alternatives that could address them.','more_how-to-leverage-conflict-in-product-management','How to Leverage Conflict in Product Management'),F('Agree on a workable option and state the tradeoff, accepted downside, and follow-up action.','more_conflict-resolution-tips-product-managers-product-owners','Conflict Resolution Tips for Product People')],conf=['Consensus building','Tradeoff analysis'])
add(53,[F('The product backlog is an ordered, evolving list of work needed to improve the product.','scrum_guide','Product Backlog'),F('The Product Owner is accountable for ordering backlog items and making the backlog visible and understood.','scrum_guide','Product Owner'),F('Review a messy backlog against the product goal, remove obsolete items, clarify relevant work, and place the most valuable upcoming items first.','new_backlogs','What is a product backlog?'),F('Explain the top items’ value and ordering, and revisit the order as customer or business needs change.','new_backlogs','What is a product backlog?')],mis=[F('A backlog is not a fixed promise to implement every item ever added to it.','new_backlogs','What is a product backlog?')],conf=['Product roadmap'])
add(55,[F('Technical feasibility assesses whether a proposed solution can be built with the available technology, skills, and constraints.','atl_product-design','What is product design?'),F('A PM supplies the intended user outcome and product constraints while engineering evaluates technical options and limitations.','atl_product-specification','Best practices for writing product specifications'),F('Ask engineering about implementation constraints, dependencies, technical uncertainty, and the effort needed to achieve the proposed behavior.','atl_product-specification','Key components of a product specification'),F('Clarify whether an answer identifies a hard constraint, a manageable risk, or a cost-and-scope tradeoff, then adjust the proposal accordingly.','atl_product-specification','Best practices for writing product specifications')],mis=[F('A PM-depth feasibility discussion is not a substitute for engineering’s implementation design.','scrum_guide','Topic Three: How will the chosen work get done?')],conf=['Effort estimation','Tradeoff analysis'])
add(56,[F('Sprint Planning creates the upcoming sprint’s plan through collaboration across the Scrum Team.','scrum_guide','Sprint Planning'),F('The Product Owner prepares the important backlog items and explains how they map to the Product Goal.','scrum_guide','Sprint Planning'),F('The team establishes a Sprint Goal, while Developers select feasible work using their past performance and upcoming capacity.','scrum_guide','Topic Two: What can be Done this Sprint?'),F('Prepare a PM/PO briefing with the proposed goal, priority rationale, clear item scope, and answers to value or requirement questions.','scrum_guide','Sprint Planning')],mis=[F('The PM/PO does not dictate how Developers turn selected backlog items into working product increments.','scrum_guide','Topic Three: How will the chosen work get done?')],conf=['Product backlog management'])
add(57,[F('The Daily Scrum is a 15-minute Developer event to inspect progress toward the Sprint Goal and adapt the upcoming plan.','scrum_guide','Daily Scrum'),F('A Product Owner participates as a Developer when actively working on sprint backlog items; it is not inherently a management status meeting.','scrum_guide','Daily Scrum'),F('Identify impediments or unresolved product questions from the discussion and clarify who needs to act on them.','scrum_guide','Daily Scrum'),F('Handle detailed follow-up outside the short event and involve the appropriate owner instead of interrupting team self-management.','scrum_guide','Daily Scrum')],conf=['Sprint planning'])
add(59,[F('A sprint retrospective inspects how the team worked and plans improvements to quality and effectiveness.','scrum_guide','Sprint Retrospective'),F('The Scrum Team examines interactions, processes, tools, problems, and assumptions and chooses useful improvements.','scrum_guide','Sprint Retrospective'),F('Triage actions about product goals, backlog clarity, or backlog ordering to the Product Owner’s accountability.','scrum_guide','Product Owner'),F('Leave technical work planning with Developers and process improvements as collaborative team work rather than automatically assigning every action to the PM/PO.','scrum_guide','Topic Three: How will the chosen work get done?'),F('Assign clear follow-up ownership for the chosen improvements and address high-impact changes promptly.','new_retrospectives','What is a sprint retrospective?')],conf=['Sprint review'])
add(62,[F('A sprint-level blocker is a dependency that prevents selected work from progressing toward the Sprint Goal.','atl_project-management-dependencies','What are project dependencies?'),F('Identify the needed output, its provider, the blocked item, and the handoff date.','atl_project-management-dependencies','How to identify dependencies in a project'),F('Confirm the provider’s status and coordinate a workaround, alternative sequence, or escalation with the involved teams.','atl_project-management-dependencies','How to manage dependencies in project management'),F('Keep the blocker and agreed action visible until the dependency is resolved.','atl_boards','Elements of a Kanban board')],conf=['Roadmap-level dependency management'])
