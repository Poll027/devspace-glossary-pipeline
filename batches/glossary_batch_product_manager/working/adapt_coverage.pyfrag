add(70,[F('A product analytics dashboard brings together measures that support monitoring product performance.','last_dashboard-reporting','What is a dashboard?'),F('Interpret a chart in the context of its metric definition, time window, audience, and benchmark or target.','atl_product-metrics','Best practices for tracking product metrics'),F('Look for changes in trend or unusual values and compare related measures before drawing a conclusion.','last_dashboard-reporting','How to build a dashboard'),F('State the observed anomaly separately from a plausible explanation and identify what further evidence would test that explanation.','amplitude_data-driven-data-informed-data-inspired','Data-informed decision making')],mis=[F('A dashboard correlation alone does not establish why a metric changed.','amplitude_data-driven-data-informed-data-inspired','Data-informed decision making')],conf=['Leading and lagging indicators'])
