add(77,[F('A holdout group is a randomly selected subset excluded from a change so it remains a comparison baseline.','doc_holdouts','Holdout groups: Exclude users from your experiments'),F('Comparing target outcomes for exposed users with the held-out baseline helps estimate the change’s incremental effect over time.','doc_holdouts','Holdout groups: Exclude users from your experiments'),F('Define the eligible audience, holdout size, excluded changes, comparison metric, and observation period.','doc_holdouts','Create a holdout group'),F('Choose the holdout size using both available traffic and the statistical needs of the comparison; Amplitude describes 5–10% as a starting recommendation, not a universal requirement.','doc_holdouts','Traffic allocation'),F('Keep assignment and exclusions consistent through the observation period so baseline users do not receive the treatment.','doc_holdouts','Variations')],mis=[F('A holdout configured in Amplitude cannot protect users from experiments that were not configured to include that holdout.','doc_holdouts','Include a holdout group in an experiment')],conf=['A/B testing','Feature flags'])
add(78,[F('Launch readiness checks whether the capabilities needed to safely introduce and support the product are in place.','atl_product-launch-checklist','What is a product launch checklist?'),F('Readiness includes technical quality, support preparation, sales preparation, monitoring, and operational response.','atl_product-launch-checklist','How to create a product launch checklist'),F('Complete each readiness check with evidence, a responsible owner, and an unresolved action for any failed item.','atl_product-launch-checklist','How to create a product launch checklist'),F('Use the agreed checklist to recommend proceeding or holding, explicitly identifying any unmet gate and the risk it creates.','atl_product-release','Product release challenges and how to overcome them')],conf=['Release management'])
add(84,[F('Synthesis connects observed usability problems to design changes rather than merely forwarding session notes.','nngroup_usability-testing-101','Why Do We Need to Test?'),F('Interpret observations alongside recruitment, task design, facilitation, and other data before treating them as reliable findings.','ux_usability-data-in-analysis','How to Assess Usability Data'),F('Look for repeated and consistent evidence and distinguish a real pattern from an isolated or confounded observation.','ux_usability-data-in-analysis','How to Assess Usability Data'),F('Rank findings by their consequence for the user’s goal and strength of supporting evidence, then propose specific changes connected to the highest-priority findings.','ux_usability-data-in-analysis','How to Assess Usability Data'),F('Discuss the proposed changes with design and retain the supporting findings so later decisions can be checked against the original evidence.','ux_archiving-usability-reports','Benefits of Keeping Reports')],conf=['Giving design feedback','Usability testing'])
# Supply narrowly scoped missing mechanics to the mapped units.
def amend(i,extra=(),mis=None,conf=None,exception=''):
 f,m,c,e,opt=DATA[i];DATA[i]=(f+list(extra),m if mis is None else mis,c if conf is None else conf,exception,opt)
amend(0,conf=[])
amend(7,[F('Write a job statement with the triggering situation, the customer’s motivation, and the outcome they want rather than a requested feature.','extra_jobs-to-be-done-framework','How Can Product Managers Use the JTBD Framework?')])
amend(8,[F('Group related observations into themes and record recurrence and the user consequence associated with each theme.','nngroup_affinity-diagram','What Is Affinity Diagramming?')])
amend(9,[F('Ask about one issue per question so a respondent is not forced to give a single answer to two different questions.','more_survey-best-practices','Avoid Double-Barreled Questions')])
amend(20,[F('For a requested one-page summary, keep the problem, proposed solution, intended impact, and essential context while removing specialist detail.','atl_product-brief','What is a product brief?')],exception='The source supports concise briefs but does not prescribe a universal one-page rule; single-page length is the frozen exercise constraint.')
amend(26,[F('Calculate historical velocity as completed work units divided by the number of observed iterations; a baseline period forecast is average velocity × available iterations, adjusted for changed availability.','atl_velocity-scrum','How to calculate velocity in Scrum')])
amend(30,conf=['Product roadmap','Capacity planning'])
amend(43,[O[40][0][2]],conf=['Market segmentation'])
amend(44,[F('For cross-functional friction, make each function’s needs and constraints explicit and seek an option that supports the shared outcome.','more_conflict-resolution-tips-product-managers-product-owners','Conflict Resolution Tips for Product People')])
amend(45,[F('If consensus is impractical, agree on an alternative decision rule explicitly and document the decision and remaining objections.','more_decision-rules-to-make-better-product-decisions','Which Decision Rule Should I Use?')])
amend(58,exception='')
amend(61,[F('Reserve an explicit share of available capacity for debt work when its impact justifies it, and explain the resulting feature-versus-debt tradeoff rather than assuming a universal ratio.','pp_technical-debt','How to Deal with Technical Debt')])
amend(65,conf=['Release planning','Definition of Done'])
amend(69,[F('Set the smallest result that would count as success and identify evidence that would contradict the expectation before testing it.','doc_goals','Define your success goals')])
