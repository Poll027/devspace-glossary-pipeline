{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "batch_id",
    "packs"
  ],
  "additionalProperties": false,
  "properties": {
    "batch_id": {
      "const": "glossary_batch_product_manager"
    },
    "packs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "career_family_id",
          "file",
          "source_count"
        ],
        "additionalProperties": false,
        "properties": {
          "career_family_id": {
            "const": "product_manager"
          },
          "file": {
            "const": "batches/glossary_batch_product_manager/product_manager.source_pack.json"
          },
          "source_count": {
            "const": 9
          }
        }
      }
    }
  }
}
