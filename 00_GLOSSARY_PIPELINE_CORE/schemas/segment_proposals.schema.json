{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "segment_proposals.schema.json",
  "title": "Segment Proposals (batch output)",
  "description": "08_segment_detection's output (playbook §14–15, §28.3). One detector pass per candidate video, proposing standalone ranges for every concept that video was a candidate for. Unverified until 09_segment_judge.",
  "type": "object",
  "required": ["metadata", "batch_id", "proposals", "rejected_videos"],
  "properties": {
    "metadata": { "$ref": "batch_artifact_metadata.schema.json" },
    "batch_id": { "type": "string" },
    "proposals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["proposal_id", "concept_id", "path_id", "video_id", "start_seconds", "end_seconds", "label", "role", "covered_fact_ids", "visual_mode", "chapter_aligned", "transcript_evidence", "issues"],
        "properties": {
          "proposal_id": { "type": "string" },
          "concept_id": { "type": "string" },
          "path_id": { "type": "string" },
          "video_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{11}$" },
          "start_seconds": { "type": "integer", "minimum": 0 },
          "end_seconds": { "type": "integer", "minimum": 1 },
          "label": { "type": "string" },
          "role": { "enum": ["mental_model", "visual_mechanism", "worked_example", "live_code_demo", "tool_workflow"], "description": "Sets the expected duration band (playbook §15)." },
          "covered_fact_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "visual_mode": {
            "$ref": "glossary_learning_bundle.schema.json#/$defs/visual_mode",
            "description": "Inferred from chapter titles, thumbnails and transcript cues ('as you can see here', 'let me draw'). Stated as an inference; the judge weighs it."
          },
          "chapter_aligned": { "type": "boolean", "description": "true when start (and ideally end) sits on a creator chapter marker." },
          "transcript_evidence": { "type": "string", "minLength": 5, "description": "A real quote from inside the range, copied from the cached transcript." },
          "issues": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    },
    "rejected_videos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["video_id", "concept_id", "reason"],
        "properties": { "video_id": { "type": "string" }, "concept_id": { "type": "string" }, "reason": { "type": "string" } },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
