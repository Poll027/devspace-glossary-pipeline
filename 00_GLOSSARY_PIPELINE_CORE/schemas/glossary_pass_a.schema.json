{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary_pass_a.schema.json",
  "title": "Glossary Pass A (batch output)",
  "description": "05_glossary_pass_a's output: the Devspace text written from TOC + coverage + evidence, before any video is looked at (playbook §8), plus the video-need decision (§9).",
  "type": "object",
  "required": ["metadata", "batch_id", "entries"],
  "properties": {
    "metadata": { "$ref": "batch_artifact_metadata.schema.json" },
    "batch_id": { "type": "string" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["concept_id", "path_id", "teaching_blocks", "video_need", "teaching_notes"],
        "properties": {
          "concept_id": { "type": "string" },
          "path_id": { "type": "string" },
          "teaching_blocks": { "type": "array", "minItems": 1, "items": { "$ref": "glossary_learning_bundle.schema.json#/$defs/teaching_block" } },
          "video_need": { "$ref": "glossary_learning_bundle.schema.json#/$defs/video_need" },
          "teaching_notes": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
