{"video_id": "Pugt2VIB_uU", "channel_id": "UC8luCii2A3k0oeZAhz_adGA", "fetched_at": "2026-11-25T03:47:51.737103+00:00", "fetch_tool": "yt-dlp 2026.08.19", "caption_track_type": "creator_uploaded", "segments": [{"start_seconds": 0.46, "end_seconds": 1.99, "text": "Every developer sees red."}, {"start_seconds": 2.29, "end_seconds": 3.32, "text": "Beginners panic."}, {"start_seconds": 3.62, "end_seconds": 4.73, "text": "Professionals read it."}, {"start_seconds": 5.03, "end_seconds": 6.75, "text": "Because an error message isn't"}, {"start_seconds": 6.61, "end_seconds": 7.32, "text": "a failure."}, {"start_seconds": 7.61, "end_seconds": 8.28, "text": "It's a clue."}, {"start_seconds": 10.96, "end_seconds": 11.84, "text": "In this lesson,"}, {"start_seconds": 12.02, "end_seconds": 13.31, "text": "we'll make three real"}, {"start_seconds": 13.18, "end_seconds": 15.02, "text": "mistakes, on purpose,"}, {"start_seconds": 15.14, "end_seconds": 16.66, "text": "and learn to read exactly"}, {"start_seconds": 16.53, "end_seconds": 18.15, "text": "what Flutter is telling us."}, {"start_seconds": 18.43, "end_seconds": 19.47, "text": "Mistake number one:"}, {"start_seconds": 19.75, "end_seconds": 20.84, "text": "a tiny typo."}, {"start_seconds": 21.14, "end_seconds": 22.48, "text": "I change setState,"}, {"start_seconds": 22.57, "end_seconds": 23.86, "text": "with a capital S,"}, {"start_seconds": 23.92, "end_seconds": 24.83, "text": "to setstate,"}, {"start_seconds": 24.97, "end_seconds": 26.16, "text": "all lowercase."}, {"start_seconds": 26.45, "end_seconds": 27.01, "text": "And look!"}, {"start_seconds": 27.3, "end_seconds": 28.91, "text": "VS Code underlines it in"}, {"start_seconds": 28.77, "end_seconds": 30.6, "text": "red, before I even run"}, {"start_seconds": 30.46, "end_seconds": 31.13, "text": "the app."}, {"start_seconds": 31.41, "end_seconds": 32.94, "text": "Let's open the Problems panel,"}, {"start_seconds": 33.2, "end_seconds": 34.02, "text": "and read it like a"}, {"start_seconds": 33.88, "end_seconds": 35.39, "text": "detective. Where?"}, {"start_seconds": 35.68, "end_seconds": 36.52, "text": "main dot dart,"}, {"start_seconds": 36.66, "end_seconds": 37.57, "text": "line sixty."}, {"start_seconds": 37.87, "end_seconds": 39.72, "text": "What? The method setstate"}, {"start_seconds": 39.76, "end_seconds": 40.7, "text": "isn't defined."}, {"start_seconds": 40.98, "end_seconds": 41.67, "text": "And the hint:"}, {"start_seconds": 41.91, "end_seconds": 43.21, "text": "try correcting the name."}, {"start_seconds": 43.54, "end_seconds": 44.5, "text": "Three questions,"}, {"start_seconds": 44.61, "end_seconds": 46.01, "text": "and the error answers all"}, {"start_seconds": 45.88, "end_seconds": 46.33, "text": "of them."}, {"start_seconds": 46.62, "end_seconds": 47.85, "text": "If you save anyway,"}, {"start_seconds": 47.98, "end_seconds": 49.73, "text": "the Debug Console shows the"}, {"start_seconds": 49.59, "end_seconds": 50.47, "text": "same error,"}, {"start_seconds": 50.65, "end_seconds": 52.13, "text": "this time from the compiler,"}, {"start_seconds": 52.26, "end_seconds": 53.26, "text": "with the line number,"}, {"start_seconds": 53.55, "end_seconds": 54.75, "text": "and a little arrow under"}, {"start_seconds": 54.62, "end_seconds": 55.39, "text": "the mistake."}, {"start_seconds": 55.68, "end_seconds": 56.73, "text": "The fix is easy."}, {"start_seconds": 57.04, "end_seconds": 58.25, "text": "I put the capital S"}, {"start_seconds": 58.11, "end_seconds": 59.47, "text": "back, save,"}, {"start_seconds": 59.63, "end_seconds": 61.25, "text": "and the red line disappears."}, {"start_seconds": 61.53, "end_seconds": 63.44, "text": "Mistake number two only shows"}, {"start_seconds": 63.3, "end_seconds": 64.74, "text": "up while the app runs."}, {"start_seconds": 65.04, "end_seconds": 66.2, "text": "I put a long sentence"}, {"start_seconds": 66.07, "end_seconds": 66.75, "text": "in a Row,"}, {"start_seconds": 66.92, "end_seconds": 68.29, "text": "too long for the screen,"}, {"start_seconds": 68.45, "end_seconds": 69.16, "text": "and save."}, {"start_seconds": 69.43, "end_seconds": 70.74, "text": "See those yellow and black"}, {"start_seconds": 70.6, "end_seconds": 72.31, "text": "stripes? That's Flutter"}, {"start_seconds": 72.17, "end_seconds": 74.09, "text": "saying: something doesn't fit."}, {"start_seconds": 74.38, "end_seconds": 75.91, "text": "Remember the rotated phone,"}, {"start_seconds": 76.23, "end_seconds": 77.43, "text": "earlier in this section?"}, {"start_seconds": 77.72, "end_seconds": 78.76, "text": "Same kind of error."}, {"start_seconds": 79.06, "end_seconds": 80.9, "text": "The Debug Console tells us"}, {"start_seconds": 80.76, "end_seconds": 82.31, "text": "which widget overflowed,"}, {"start_seconds": 82.45, "end_seconds": 83.82, "text": "by how many pixels,"}, {"start_seconds": 84.07, "end_seconds": 85.34, "text": "and it even suggests a"}, {"start_seconds": 85.2, "end_seconds": 87.39, "text": "fix: wrapping the child in"}, {"start_seconds": 87.25, "end_seconds": 88.52, "text": "an Expanded widget."}, {"start_seconds": 88.79, "end_seconds": 89.98, "text": "Mistake number three:"}, {"start_seconds": 90.26, "end_seconds": 91.12, "text": "a crash."}, {"start_seconds": 91.43, "end_seconds": 92.63, "text": "I changed the label to"}, {"start_seconds": 92.49, "end_seconds": 93.67, "text": "read from a list of"}, {"start_seconds": 93.53, "end_seconds": 94.5, "text": "three words:"}, {"start_seconds": 94.75, "end_seconds": 96.14, "text": "zero, one,"}, {"start_seconds": 96.28, "end_seconds": 96.92, "text": "and two."}, {"start_seconds": 97.22, "end_seconds": 98.29, "text": "Tap, tap,"}, {"start_seconds": 98.42, "end_seconds": 99.36, "text": "and it says two."}, {"start_seconds": 99.64, "end_seconds": 100.81, "text": "Now one more tap,"}, {"start_seconds": 100.99, "end_seconds": 102.27, "text": "and the whole screen turns"}, {"start_seconds": 102.13, "end_seconds": 103.98, "text": "red. That's Flutter's red"}, {"start_seconds": 103.93, "end_seconds": 104.76, "text": "error screen."}, {"start_seconds": 105.06, "end_seconds": 106.07, "text": "You only see it while"}, {"start_seconds": 105.94, "end_seconds": 108.01, "text": "debugging. In a release build,"}, {"start_seconds": 108.26, "end_seconds": 109.4, "text": "your users would see a"}, {"start_seconds": 109.26, "end_seconds": 111.07, "text": "plain grey area instead."}, {"start_seconds": 111.35, "end_seconds": 112.71, "text": "In the Debug Console,"}, {"start_seconds": 112.85, "end_seconds": 114.53, "text": "the message looks long and"}, {"start_seconds": 114.39, "end_seconds": 116.18, "text": "scary. Here's the trick:"}, {"start_seconds": 116.38, "end_seconds": 117.71, "text": "skip down to the first"}, {"start_seconds": 117.57, "end_seconds": 118.95, "text": "line that mentions your own"}, {"start_seconds": 118.81, "end_seconds": 120.57, "text": "file. main dot dart,"}, {"start_seconds": 120.76, "end_seconds": 121.95, "text": "line one oh seven."}, {"start_seconds": 122.24, "end_seconds": 123.51, "text": "And the message says it:"}, {"start_seconds": 123.86, "end_seconds": 124.97, "text": "invalid value,"}, {"start_seconds": 125.22, "end_seconds": 126.54, "text": "not in range zero to"}, {"start_seconds": 126.4, "end_seconds": 127.73, "text": "two: three."}, {"start_seconds": 128.01, "end_seconds": 129.66, "text": "Our list has three items,"}, {"start_seconds": 129.71, "end_seconds": 130.95, "text": "at positions zero,"}, {"start_seconds": 131.1, "end_seconds": 131.99, "text": "one and two."}, {"start_seconds": 132.28, "end_seconds": 133.92, "text": "We asked for position three,"}, {"start_seconds": 134.06, "end_seconds": 135.26, "text": "which doesn't exist."}, {"start_seconds": 135.54, "end_seconds": 136.45, "text": "So let's fix it."}, {"start_seconds": 136.74, "end_seconds": 138.51, "text": "The index must stay inside"}, {"start_seconds": 138.37, "end_seconds": 139.09, "text": "the list."}, {"start_seconds": 139.4, "end_seconds": 140.76, "text": "I add percent three:"}, {"start_seconds": 141.0, "end_seconds": 142.47, "text": "the remainder after dividing"}, {"start_seconds": 142.33, "end_seconds": 143.15, "text": "by three."}, {"start_seconds": 143.45, "end_seconds": 144.97, "text": "So it always gives zero,"}, {"start_seconds": 145.13, "end_seconds": 146.34, "text": "one, or two."}, {"start_seconds": 146.64, "end_seconds": 148.44, "text": "Save, hot reload,"}, {"start_seconds": 148.62, "end_seconds": 149.58, "text": "and the red screen is"}, {"start_seconds": 149.45, "end_seconds": 151.34, "text": "gone. The counter is still"}, {"start_seconds": 151.2, "end_seconds": 153.09, "text": "three, and the label wraps"}, {"start_seconds": 152.96, "end_seconds": 154.27, "text": "back around to zero."}, {"start_seconds": 155.22, "end_seconds": 156.34, "text": "And when the message isn't"}, {"start_seconds": 156.21, "end_seconds": 157.79, "text": "enough, search smart."}, {"start_seconds": 158.08, "end_seconds": 159.32, "text": "Copy the key line of"}, {"start_seconds": 159.18, "end_seconds": 159.85, "text": "the error,"}, {"start_seconds": 159.96, "end_seconds": 160.81, "text": "and search for it."}, {"start_seconds": 161.11, "end_seconds": 163.12, "text": "The official docs and pub.dev"}, {"start_seconds": 163.09, "end_seconds": 164.33, "text": "are your best friends."}, {"start_seconds": 164.62, "end_seconds": 165.72, "text": "And if you're still stuck,"}, {"start_seconds": 165.99, "end_seconds": 167.63, "text": "ask, with what you tried,"}, {"start_seconds": 167.74, "end_seconds": 168.52, "text": "and the error."}, {"start_seconds": 168.8, "end_seconds": 169.73, "text": "Try it yourself."}, {"start_seconds": 170.04, "end_seconds": 170.97, "text": "Pause the video,"}, {"start_seconds": 171.25, "end_seconds": 172.43, "text": "make your own typo in"}, {"start_seconds": 172.3, "end_seconds": 173.22, "text": "main dot dart,"}, {"start_seconds": 173.36, "end_seconds": 174.04, "text": "and save."}, {"start_seconds": 174.34, "end_seconds": 175.64, "text": "Then read the error like"}, {"start_seconds": 175.5, "end_seconds": 176.32, "text": "a detective:"}, {"start_seconds": 176.59, "end_seconds": 177.82, "text": "where, what,"}, {"start_seconds": 177.99, "end_seconds": 178.72, "text": "and the hint."}, {"start_seconds": 179.01, "end_seconds": 180.09, "text": "Ready? Go!"}, {"start_seconds": 180.38, "end_seconds": 181.17, "text": "Quick question."}, {"start_seconds": 181.46, "end_seconds": 182.54, "text": "What's the first thing to"}, {"start_seconds": 182.4, "end_seconds": 183.56, "text": "do when you see an"}, {"start_seconds": 183.43, "end_seconds": 184.96, "text": "error? Take a moment to"}, {"start_seconds": 184.82, "end_seconds": 185.41, "text": "think."}, {"start_seconds": 190.77, "end_seconds": 191.25, "text": "Read it."}, {"start_seconds": 191.54, "end_seconds": 192.86, "text": "The answer is usually right"}, {"start_seconds": 192.72, "end_seconds": 193.19, "text": "there."}, {"start_seconds": 193.56, "end_seconds": 195.12, "text": "That's Section Zero done."}, {"start_seconds": 195.41, "end_seconds": 197.18, "text": "Next, we start programming"}, {"start_seconds": 197.05, "end_seconds": 197.7, "text": "with Dart,"}, {"start_seconds": 197.87, "end_seconds": 198.89, "text": "right in your browser."}, {"start_seconds": 199.17, "end_seconds": 200.23, "text": "No setup needed,"}, {"start_seconds": 200.41, "end_seconds": 201.11, "text": "and it's going to be"}, {"start_seconds": 200.97, "end_seconds": 201.52, "text": "fun."}]}